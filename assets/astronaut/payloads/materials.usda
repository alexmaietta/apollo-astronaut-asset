    def Material "HelmetVisor"
    {
        token outputs:mdl:displacement.connect = </Looks/HelmetVisor/Shader.outputs:out>
        token outputs:mdl:surface.connect = </Looks/HelmetVisor/Shader.outputs:out>
        token outputs:mdl:volume.connect = </Looks/HelmetVisor/Shader.outputs:out>
        token outputs:surface.connect = </Looks/HelmetVisor/PreviewSurface.outputs:surface>

        def Shader "Shader"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
            float inputs:depth = 0.01 (
                customData = {
                    float default = 0.001
                    dictionary range = {
                        float max = 1000
                        float min = 0
                    }
                }
                displayGroup = "Color"
                displayName = "Volume Absorption Scale"
            )
            bool inputs:enable_opacity = 0 (
                customData = {
                    bool default = 0
                }
