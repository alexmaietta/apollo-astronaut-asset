#usda 1.0
(
    defaultPrim = "Looks"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Looks"
{
    def Material "Body"
    {
        token outputs:mdl:displacement.connect = </Looks/Body/Shader.outputs:out>
        token outputs:mdl:surface.connect = </Looks/Body/Shader.outputs:out>
        token outputs:mdl:volume.connect = </Looks/Body/Shader.outputs:out>
        token outputs:surface.connect = </Looks/Body/PreviewSurface.outputs:surface>

        def Shader "Shader"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
            asset inputs:diffuse_texture = @./Textures/Materials/Body_MDL/astronaut_04_jackletS_BaseColor.png@ (
                colorSpace = "auto"
                customData = {
                    asset default = @@
                }
                displayGroup = "Albedo"
                displayName = "Albedo Map"
            )
            asset inputs:metallic_texture = @./Textures/Materials/Body_MDL/astronaut_04_jackletS_Metalness.png@ (
                colorSpace = "raw"
                customData = {
                    asset default = @@
                }
                displayGroup = "Reflectivity"
                displayName = "Metallic Map"
            )
            float inputs:metallic_texture_influence = 1 (
                customData = {
                    float default = 0
                    dictionary range = {
                        float max = 1
                        float min = 0
                    }
                }
                displayGroup = "Reflectivity"
                displayName = "Metallic Map Influence"
            )
            asset inputs:normalmap_texture = @./Textures/Materials/Body_MDL/astronaut_04_jackletS_Normal.png@ (
                colorSpace = "raw"
                customData = {
                    asset default = @@
                }
                displayGroup = "Normal"
                displayName = "Normal Map"
            )
            float inputs:reflection_roughness_texture_influence = 1 (
                customData = {
                    float default = 0
                    dictionary range = {
                        float max = 1
                        float min = 0
                    }
                }
                displayGroup = "Reflectivity"
                displayName = "Roughness Map Influence"
            )
            asset inputs:reflectionroughness_texture = @./Textures/Materials/Body_MDL/astronaut_04_jackletS_Roughness.png@ (
                colorSpace = "raw"
                customData = {
                    asset default = @@
                }
                displayGroup = "Reflectivity"
                displayName = "Roughness Map"
            )
            token outputs:out
        }

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.8, 0.79, 0.75)
            color3f inputs:diffuseColor.connect = </Looks/Body/BaseColorTex.outputs:rgb>
            float inputs:metallic = 0
            float inputs:metallic.connect = </Looks/Body/MetallicTex.outputs:r>
            normal3f inputs:normal.connect = </Looks/Body/NormalTex.outputs:rgb>
            float inputs:opacity = 1
            float inputs:roughness = 0.8
            float inputs:roughness.connect = </Looks/Body/RoughnessTex.outputs:r>
            token outputs:surface
        }

        def Shader "stReader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "BaseColorTex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./Textures/Materials/Body_MDL/astronaut_04_jackletS_BaseColor.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </Looks/Body/stReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "NormalTex"
        {
            uniform token info:id = "UsdUVTexture"
            float4 inputs:bias = (-1, -1, -1, 0)
            asset inputs:file = @./Textures/Materials/Body_MDL/astronaut_04_jackletS_Normal.png@
            float4 inputs:scale = (2, 2, 2, 1)
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Looks/Body/stReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "RoughnessTex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./Textures/Materials/Body_MDL/astronaut_04_jackletS_Roughness.png@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Looks/Body/stReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float outputs:r
        }

        def Shader "MetallicTex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./Textures/Materials/Body_MDL/astronaut_04_jackletS_Metalness.png@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Looks/Body/stReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float outputs:r
        }
    }

