#usda 1.0
(
    defaultPrim = "astronaut"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "astronaut"
{
    def Scope "BodyColliders"
    {
        def Material "SuitMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.7
            float physics:staticFriction = 0.8
        }

        def Xform "Torso0" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
            customData = {
                dictionary astronaut = {
                    string skinJoint = "Chest"
                }
            }
        )
        {
            rel physics:filteredPairs = [
                </astronaut/Hands/Left/LeftHandWrist>,
                </astronaut/Hands/Right/RightHandWrist>,
            ]
            float physics:mass = 1
            quatf xformOp:orient = (-0.0220648, 0.70676243, 0.70676243, -0.0220648)
            double3 xformOp:translate = (0.01, 0, 1.3659999999999999)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Capsule "Collider" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token axis = "Z"
                double height = 0.3800000000000001
                rel material:binding:physics = </astronaut/BodyColliders/SuitMaterial> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                uniform token purpose = "guide"
                double radius = 0.15
                quatf xformOp:orient = (0, 0, 0.99951303, -0.03120434)
                double3 xformOp:translate = (-0.06, 0.03218719565607314, 0.1943707396595425)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }

