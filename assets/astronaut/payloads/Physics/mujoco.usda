#usda 1.0
(
    defaultPrim = "astronaut"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "astronaut"
{
    over "Physics"
    {
        over "LeftHandIndexProximal_abd" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            custom double mjc:armature = 0.0005
            custom double mjc:damping = 0.004
            custom double mjc:springref = 0
            custom double mjc:stiffness = 0.25
        }

        def MjcActuator "LeftHandIndexProximal_abd_servo"
        {
            custom double[] mjc:biasPrm = [0, -2.5, -0.05, 0, 0, 0, 0, 0, 0, 0]
            custom token mjc:biasType = "affine"
            custom token mjc:forceLimited = "true"
            custom double mjc:forceRange:max = 1
            custom double mjc:forceRange:min = -1
            custom double[] mjc:gainPrm = [2.5, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            custom token mjc:gainType = "fixed"
            custom rel mjc:target = </astronaut/Physics/LeftHandIndexProximal_abd>
        }

        over "LeftHandIndexProximal_flex" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            custom double mjc:armature = 0.0005
            custom double mjc:damping = 0.004
            custom double mjc:springref = 0
            custom double mjc:stiffness = 0.3
        }

        def MjcActuator "LeftHandIndexProximal_flex_servo"
        {
            custom double[] mjc:biasPrm = [0, -2.5, -0.05, 0, 0, 0, 0, 0, 0, 0]
            custom token mjc:biasType = "affine"
            custom token mjc:forceLimited = "true"
            custom double mjc:forceRange:max = 3
            custom double mjc:forceRange:min = -3
            custom double[] mjc:gainPrm = [2.5, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            custom token mjc:gainType = "fixed"
            custom rel mjc:target = </astronaut/Physics/LeftHandIndexProximal_flex>
        }

        over "LeftHandIndexIntermediate_flex" (
