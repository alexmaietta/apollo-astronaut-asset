        def Material "GloveMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            custom float newton:contactDamping = 100
            custom float newton:contactStiffness = 2500
            custom float newton:rollingFriction = 0.0001
            custom float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 0.9
            float physics:restitution = 0
            float physics:staticFriction = 1
        }

